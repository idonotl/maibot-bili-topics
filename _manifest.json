{
  "manifest_version": 2,
  "id": "local.bili-topics",
  "version": "0.7.0",
  "name": "B站话题 · 麦麦适配版",
  "description": "处理用户分享的 B站视频：先联合理解完整音轨和分段画面，再按人设回应；保留公开搜索、主动浏览与表达学习素材功能。",
  "author": {
    "name": "idonotl",
    "url": "https://github.com/idonotl"
  },
  "license": "MIT",
  "urls": {
    "repository": "https://github.com/idonotl/maibot-bili-topics",
    "homepage": "https://github.com/idonotl/maibot-bili-topics",
    "documentation": "https://github.com/idonotl/maibot-bili-topics/blob/main/README.md",
    "issues": "https://github.com/idonotl/maibot-bili-topics/issues"
  },
  "host_application": {
    "min_version": "1.3.15",
    "max_version": "1.3.19"
